<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.JungleSanctuaryTheme"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.JungleSanctuaryTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DefaultStage Configuration -->

            <!-- The unique name/id of the Stage -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="JungleSanctuary" />

            <!-- Stage style at launch
                 "0": StageStyle.Automatic, a system default setting, set to Mixed currently (default)
                 "1": StageStyle.Mixed — displays both virtual content and the real environment at full intensity (100% each)
                 "2": StageStyle.Progressive — system immersion also affects foreground models.
                 "3": StageStyle.Full — displays only virtual content (100%)
             -->
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="1" />
            <!-- SkySettings controls only sky.glb; Mixed keeps all foreground models visible. -->

        </activity>

    </application>

</manifest>
